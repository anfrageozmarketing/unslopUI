# Copy to .env and fill. Never commit .env.
# Users: output of `node hash-password.mjs <name>`, comma separated. The app refuses to start without it.
CC_USERS=
# Host name served by the reverse proxy, e.g. brain.example.internal
CC_HOST=
# Source IPs/CIDRs allowed to reach the app (comma separated), e.g. 203.0.113.10/32,10.8.0.0/24
CC_ALLOW_IPS=
# Path of the private vault on the server
VAULT_PATH=./vault
PROXY_NETWORK=proxy
CERT_RESOLVER=letsencrypt
